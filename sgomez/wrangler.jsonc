{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sgomez",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "sgomez" }],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  // Las ramas que no son main publican una vista previa con `wrangler preview`, que exige este bloque (puede ir vacío).
  // Sin él, el build de Workers de cada PR salía en rojo aunque main compilara bien.
  "previews": {}
}
