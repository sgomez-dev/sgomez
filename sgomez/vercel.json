{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(?!api(?:/|$)|_next/static/|_next/image)(?:.*)$",
      "transforms": [
        {
          "type": "response.headers",
          "op": "set",
          "target": { "key": "Vary" },
          "args": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch, Accept, Accept-Encoding"
        }
      ],
      "continue": true
    }
  ]
}
